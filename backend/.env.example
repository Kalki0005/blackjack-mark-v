DATABASE_URL=postgresql://user:password@host/database?sslmode=require
SECRET_KEY=replace_me

# Where the frontend (Vite) and backend run — used for OAuth redirects.
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Google Identity Services — create an OAuth 2.0 Client ID (Web application)
# at https://console.cloud.google.com/apis/credentials
# Add http://localhost:5173 to "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# Discord OAuth2 app — https://discord.com/developers/applications
# Add http://localhost:5000/api/auth/discord/callback as a redirect URI.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Apple Sign In (Services ID). Requires an Apple Developer account.
APPLE_CLIENT_ID=
